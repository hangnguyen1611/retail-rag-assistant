# --- Groq API ---
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_JUDGE_MODEL=qwen/qwen3.6-27b

# GROQ_TEMPERATURE=0.2
# GROQ_MAX_TOKENS=600
# GROQ_REASONING_EFFORT=low

# --- Vector store / embedding (thường không cần đổi) ---
# CHROMA_PERSIST_DIR=./chroma_db
# EMBEDDING_MODEL=intfloat/multilingual-e5-small

# --- Clean data & Eval ----
# PRODUCTS_N_SAMPLES=5000
# EVAL_CONCURRENCY=1

# --- Backend CORS (đổi nếu frontend chạy ở origin khác) ---
# CORS_ALLOW_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
